{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Launch Dev Server",
      "program": "${workspaceFolder}/server.ts",
      "preLaunchTask": "npm: install",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--host", "0.0.0.0"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
